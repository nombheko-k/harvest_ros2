<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:macro name="rail" params="parent_link">
		<link name="rail_link">
			<visual>
				<geometry>
					<box size="2.0 0.1 0.05"/>
				</geometry>
				<material name="silver"/>
			</visual>
		</link>

		<joint name="world_to_rail" type="fixed">
			<parent link="${parent_link}"/>
			<child link="rail_link"/>
			<origin xyz="0 0 0" rpy="0 0 0"/>
		</joint>

		<link name="base_link">
			<visual>
				<geometry>
					<cylinder radius="0.1" length="0.1"/>
				</geometry>
				<material name="blue"/>
			</visual>
		</link>

		<joint name="rail_joint" type="prismatic">
			<parent link="rail_link"/>
			<child link="base_link"/>
			<axis xyz="1 0 0"/>
			<limit lower="-0.9" upper="0.9" effort="100.0" velocity="0.5"/>
			<origin xyz="0 0 0.05" rpy="0 0 0"/>
		</joint>
	</xacro:macro>
</robot>
