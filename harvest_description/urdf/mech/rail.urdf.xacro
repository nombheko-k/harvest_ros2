<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:include filename="$(find harvest_description)/urdf/robot_utils.urdf.xacro"/>

	<xacro:macro name="rail">
		<!-- WORLD ANCHOR AND RAIL -->
		<!-- The rail macro owns the single world link used by the whole robot. -->
		<link name="world"/>

		<joint name="world_to_rail" type="fixed">
			<parent link="world"/>
			<child link="rail_link"/>
			<origin xyz="0 0 0" rpy="0 0 0"/>
		</joint> 

		<link name="rail_link">
			<visual>
			<geometry><box size="2.0 0.1 0.05"/></geometry>
			<material name="silver"/>
			</visual>
			<collision>
			<geometry><box size="2.0 0.1 0.05"/></geometry>
			</collision>
			<!-- Heavy structural aluminum rail frame (15 kg) -->
			<xacro:box_inertial mass="15.0" x="2.0" y="0.1" z="0.05">
			<origin xyz="0 0 0" rpy="0 0 0"/>
			</xacro:box_inertial>
		</link>

		<!-- 1. Rail Prismatic Joint -->
		<!-- The carriage frame is on the rail's upper face (half of its 50 mm
		     thickness), so the carriage housing rests directly on the rail. -->
		<joint name="rail_joint" type="prismatic">
			<parent link="rail_link"/>
			<child link="base_link"/>
			<axis xyz="1 0 0"/>
			<limit lower="-0.9" upper="0.9" effort="200.0" velocity="0.5"/>
			<origin xyz="0 0 0.025" rpy="0 0 0"/>
			<dynamics damping="10.0" friction="5.0"/>
		</joint>
	</xacro:macro>
</robot>
