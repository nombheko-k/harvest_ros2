<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find harvest_description)/urdf/robot_utils.urdf.xacro"/>

  <xacro:macro name="soft_gripper">
    <!-- This frame is mounted on the fourth gearbox output, above the blue link. -->
    <!-- The camera sits on the rear of the mount, away from the grasping area. -->
    <joint name="camera_joint" type="fixed">
      <parent link="end_effector_tool_mount"/>
      <child link="camera_link"/>
      <origin xyz="0.0125 0.02 0.02" rpy="0 0 0"/>
    </joint>

    <link name="camera_link">
      <visual>
        <geometry><box size="0.035 0.035 0.025"/></geometry>
        <material name="red"/>
      </visual>
      <collision>
        <geometry><box size="0.035 0.035 0.025"/></geometry>
      </collision>
      <xacro:box_inertial mass="0.05" x="0.035" y="0.035" z="0.025">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:box_inertial>
    </link>

      <!-- Finger Template Macro (Instantiates 3 flexible grasping links at 120-degree patterns) -->
    <!-- Each lightweight 80 mm finger extends forward along the arm's +X axis. -->
    <xacro:macro name="finger" params="prefix angle">
      <joint name="finger_joint_${prefix}" type="fixed">
        <parent link="end_effector_tool_mount"/>
        <child link="finger_link_${prefix}"/>
        <origin xyz="0.005 ${0.025 * cos(angle)} ${0.025 * sin(angle)}"
                rpy="${angle} 0 0"/>
      </joint>

      <link name="finger_link_${prefix}">
        <visual>
          <origin xyz="0.04 0 0" rpy="0 0 0"/>
          <geometry><box size="0.08 0.012 0.012"/></geometry>
          <material name="green"/>
        </visual>
        <collision>
          <origin xyz="0.04 0 0" rpy="0 0 0"/>
          <geometry><box size="0.08 0.012 0.012"/></geometry>
        </collision>
        <xacro:box_inertial mass="0.02" x="0.08" y="0.012" z="0.012">
          <origin xyz="0.04 0 0" rpy="0 0 0"/>
        </xacro:box_inertial>
      </link>
    </xacro:macro>

    <!-- The fingers are spaced at 120-degree intervals -->
    <xacro:finger prefix="1" angle="0.0"/>
    <xacro:finger prefix="2" angle="2.094395"/>
    <xacro:finger prefix="3" angle="4.188790"/>
  </xacro:macro>
</robot>
