<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="harvest_280">
  <!-- Enable only when a working Gazebo ros2_control backend is available. -->
  <xacro:arg name="use_gz_control" default="false"/>

  <!-- INERTIAL MATH MACROS -->
  <!-- Solid Cylinder Inertia Formula -->
  <xacro:macro name="cylinder_inertial" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * mass * (3*radius*radius + length*length)}" iyz="0.0"
               izz="${(1/2) * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid Box Inertia Formula -->
  <xacro:macro name="box_inertial" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${(1/12) * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * mass * (x*x + z*z)}" iyz="0.0"
               izz="${(1/12) * mass * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:include filename="$(find harvest_description)/urdf/mech/rail.urdf.xacro"/>
  <xacro:include filename="$(find harvest_description)/urdf/mech/harvest_arm.urdf.xacro"/>
  <xacro:include filename="$(find harvest_description)/urdf/mech/soft_gripper.urdf.xacro"/>

  <!-- Color Materials -->
  <material name="silver"><color rgba="0.7 0.7 0.7 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.0 0.8 1.0"/></material>
  <material name="green"><color rgba="0.0 0.8 0.0 1.0"/></material>
  <material name="red"><color rgba="0.8 0.0 0.0 1.0"/></material>

  <xacro:rail parent_link="world"/>
  <xacro:harvest_arm parent_link="base_link"/>
  <xacro:soft_gripper parent_link="end_effector_tool_mount"/>

  <!-- GAZEBO SIMULATION SYSTEM PLUGIN -->
  <!-- Keep the visual simulation independent from ros2_control startup. -->
  <xacro:if value="$(arg use_gz_control)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find harvest_description)/urdf/control/robot_controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- ROS2_CONTROL HARDWARE INTERFACE DEFINITION -->
  <!-- These interfaces are included only for the opt-in controlled launch. -->
  <xacro:if value="$(arg use_gz_control)">
    <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- 1. Rail Linear Actuator -->
    <joint name="rail_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <!-- 2. Base Turn-table (Yaw) -->
    <joint name="base_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <!-- 3. Shoulder (Pitch) -->
    <joint name="shoulder_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <!-- 4. Elbow (Pitch) -->
    <joint name="elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <!-- 5. Wrist Pitch -->
    <joint name="wrist_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <!-- 6. Wrist Roll -->
    <joint name="wrist_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    </ros2_control>
  </xacro:if>

</robot>
